{
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": { "run": "onType", "fixKind": "safe_fix", "unusedDisableDirectives": "deny" }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": { "run": "onSave" }
      }
    }
  },
  "format_on_save": "on",
  "formatter": [{ "language_server": { "name": "oxfmt" } }, { "code_action": "source.fixAll.oxc" }],
  "prettier": { "allowed": false }
}
